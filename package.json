{
  "name": "agentguard-x",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGuard X — The Security Control Plane for AI Agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:hardcoded": "node scripts/check-hardcoded.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo-run.ts",
    "verify:live": "tsx scripts/real-run.ts",
    "verify:receipt": "tsx scripts/verify-receipt.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "models": "tsx scripts/list-models.ts",
    "probe-model": "tsx scripts/probe-model.ts",
    "inspect-layout": "tsx scripts/inspect-layout.ts",
    "audit:routes": "tsx scripts/audit-routes.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "voice:samples": "tsx scripts/voice-samples.ts",
    "tui:preview": "tsx scripts/preview-tui.ts",
    "agentguard": "tsx apps/cli/src/index.ts",
    "ag": "tsx apps/cli/src/index.ts",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:web": "pnpm --filter @agentguard/web dev",
    "check": "pnpm typecheck && pnpm lint:hardcoded && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
