# AgentGuard X — provider configuration
# Copy to .env and fill in only what you actually have.
# NEVER commit .env. NEVER paste real keys into source or the web UI.

# --- Model providers (backend only) ---
# NVIDIA NIM (OpenAI-compatible, supports tool calling). Used first when set.
# Key from build.nvidia.com. Model names are per-account — `agentguard doctor`
# lists what is usable, and a model the account cannot serve answers 404.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Groq (OpenAI-compatible, supports tool calling). Used as the fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- The robot's voice (Murf AI) ---
# Optional. When set, the CLI speaks replies through Murf instead of the
# platform voice (Windows SAPI / macOS `say` / espeak), and falls back to the
# platform voice whenever Murf cannot answer.
#
# The account's allowance is counted in CHARACTERS and does not renew, so each
# reply is cached by (voice, text) and a repeated line is never billed twice.
# `pnpm voice:samples` renders the candidate voices to .agentguard/voice-samples
# so you can pick by ear; the three overrides below accept any voiceId from
# https://api.murf.ai/v1/speech/voices.
MURF_API_KEY=
MURF_VOICE_EN=en-US-cooper
MURF_VOICE_HINGLISH=en-IN-rohan
MURF_VOICE_HI=hi-IN-amit

# --- WhatsApp, through OpenWA (optional) ---
# OpenWA is a self-hosted, UNOFFICIAL WhatsApp gateway (reverse-engineered
# clients, not Meta's Cloud API). Read its warning first:
# https://github.com/rmyndharis/OpenWA
#
#   # in a separate checkout of OpenWA
#   npm ci && npm run dev          # API :2785, dashboard :2886
#   cat data/.api-key              # the admin key, written on first boot
#
# Then: pnpm ag whatsapp --setup   (links a session, prints the QR to scan)
#       pnpm ag whatsapp           (runs the bridge)
#
# ⚠ Use a spare number. WhatsApp restricts accounts it decides are automated,
#   and no amount of code makes that risk zero. Never your main number.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION=agentguard
# Signs each webhook. Set the same value when the bridge registers it.
OPENWA_WEBHOOK_SECRET=
# Port the bridge listens on; OpenWA posts deliveries here.
OPENWA_BRIDGE_PORT=8790
# Only these numbers get an answer; everyone else is ignored and logged.
# Matched on the last ten digits, so a country code may be left off.
WHATSAPP_ALLOWED_NUMBERS=

# --- Persistence ---
DATABASE_URL=
AGENTGUARD_DATA_DIR=.agentguard

# --- Alerting / notifications ---
# Generic webhook: receives a JSON POST for every alert.
ALERT_WEBHOOK_URL=
# Email alerts via Gmail SMTP — use a Gmail *app password*, never your login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=

# --- API / session ---
SESSION_SECRET=
PORT=8787

# --- Runtime mode ---
# local | demo  (demo forces the sandbox label in the UI)
AGENTGUARD_MODE=local
